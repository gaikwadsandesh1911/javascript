/* Redux

       - Redux is a client-side state management library used in react to manage and centralize application state.

       - It allows different components to access and update shared state without prop drilling.


   Redux-Toolkit

       Redux Toolkit (RTK) is the official recommended way to write Redux logic. 
       It simplifies Redux development by reducing boilerplate code and 
       providing utilities such as configureStore, createSlice, and createAsyncThunk


*/

npm install @reduxjs/toolkit react-redux


/*  configureStore()
    
    - First we create and configure store using configureStore() function from redux-toolkit.
      It automatically sets up useful defaults, including Redux DevTools integration

    - and registers the all reducers.
    
*/

// src/app/store.js

import { configureStore } from "@reduxjs/toolkit";
import counterReducer from "./counterSlice";

export const store = configureStore({
  reducer: {
    counter: counterReducer
  }
});


/* Provider 

     Then makes store available to all components tree, using Provider component from react-redux

*/

// main.jsx 

import React from "react";
import ReactDOM from "react-dom/client";
import { Provider } from "react-redux";
import App from "./App";
import { store } from "./redux/store";

ReactDOM.createRoot(
  document.getElementById("root")
).render(
  <Provider store={store}>
    <App />
  </Provider>
);


/* createSlice()

    then create slice. slice means redux logic for perticular feature.
    suppose application has two features like user and cart, we create slice for each feature.
    slice manages its own part of application state.

    slice contains 
      - name property. which identify slice. and generate action type names automatically.
      - initial state. mostly object
      - reducer functions.
*/


/* Reducer 

     - A reducer is a function that determines how the state should change based on the dispatched action. 

     - It receives the current state & action and returns the updated state.



   Action

       An action is a plain JavaScript object that describes what happened in the application. 
       It contains type and payload property.

*/

// src/features/counterSlice.js

import { createSlice } from "@reduxjs/toolkit";

const counterSlice = createSlice({

  name: "counter",

// generate action type names automatically like. counter/increment, counter/decrement. remember format sliceName/reducerName.

  initialState: {
    count: 0
  },

  reducers: {

    increment: (state) => {
      state.count += 1;
    },

    decrement: (state) => {
      state.count -= 1;
    },

    reset: (state) => {
      state.count = 0;
    },

    incrementByAmount: (state, action) => {
      state.count += action.payload;
    }
  }

});

export const { increment, decrement, reset, incrementByAmount } = counterSlice.actions;

export default counterSlice.reducer;


// app.jsx

import { useSelector, useDispatch } from "react-redux";

import { increment, decrement, reset, incrementByAmount } from "./redux/counterSlice";

function App() {

  const count = useSelector((state) => state.counter.count);

  const dispatch = useDispatch();

  return (
    <div>
      <h1>Count: {count}</h1>

      <button onClick={() => dispatch(increment())}>
        Increment
      </button>

      <button onClick={() => dispatch(decrement())}>
        Decrement
      </button>

      <button onClick={() => dispatch(reset())}>
        Reset
      </button>

      <button onClick={() => dispatch(incrementByAmount(5))}>
        Add 5
      </button>
    </div>
  );
}

export default App;


